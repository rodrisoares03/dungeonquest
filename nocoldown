        SpeedMultiplier = NightHub.SpeedMultiplier,
        VelocidadeExtra = NightHub.VelocidadeExtra,
        NoVFXAtivo = NightHub.NoVFXAtivo,
        Binds = {
            Spammer = Binds.Spammer,
            Farm = Binds.Farm,
            NoVFX = Binds.NoVFX,
            Speed = Binds.Speed,
            ToggleUI = Binds.ToggleUI,
            StartDungeon = Binds.StartDungeon,
        },
    }
end

local function applySnapshot(data)
    if type(data) ~= "table" then return end
    if data.OcultarNome ~= nil then NightHub.OcultarNome = data.OcultarNome end
    if data.NomePersonalizado ~= nil then NightHub.NomePersonalizado = data.NomePersonalizado end
    if data.TweenHeight ~= nil then NightHub.TweenHeight = data.TweenHeight end
    if data.TweenSpeed ~= nil then NightHub.TweenSpeed = data.TweenSpeed end
    if data.SpeedMultiplier ~= nil then NightHub.SpeedMultiplier = data.SpeedMultiplier end
    if data.VelocidadeExtra ~= nil then NightHub.VelocidadeExtra = data.VelocidadeExtra end
    if data.NoVFXAtivo ~= nil then NightHub.NoVFXAtivo = data.NoVFXAtivo end
    if type(data.Binds) == "table" then
        for k, v in pairs(data.Binds) do
            if Binds[k] ~= nil then Binds[k] = v end
        end
    end
end

