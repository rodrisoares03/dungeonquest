local function getClosestEnemy()
    local closest, shortestDist = nil, math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Name ~= LocalPlayer.Name then
            local hum = obj:FindFirstChild("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hum and hrp and hum.Health > 0 then
                local dist = (hrp.Position - myPos).Magnitude
                if dist < shortestDist then shortestDist = dist; closest = obj end
            end
        end
    end
    return closest
end

function iniciarFarm()
    if Connections.FarmLoop then return end
    Connections.FarmLoop = RunService.Heartbeat:Connect(function()
        if not NightHub.TweenFarmAtivo then return end
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            local target = getClosestEnemy()
            if target and target:FindFirstChild("HumanoidRootPart") then
                local th = target.HumanoidRootPart
                local dest = Vector3.new(th.Position.x, th.Position.y + NightHub.TweenHeight, th.Position.z)
                local dir = (dest - hrp.Position).Unit
                local dist = (dest - hrp.Position).Magnitude
                if dist > 0.5 then
                    hrp.Position = hrp.Position + dir * math.min(NightHub.TweenSpeed * 0.3, dist)
                end
                for _, t in ipairs(char:GetChildren()) do
                    if t:IsA("Tool") then pcall(function() t:Activate() end) end
                end
            end
        end)
    end)
end

function pararFarm()
    if Connections.FarmLoop then Connections.FarmLoop:Disconnect(); Connections.FarmLoop = nil end
end

-- NoVFX
local function isHabilidade(nome)
    nome = string.upper(nome)
    for _, k in ipairs({"PULSE","LIGHTNING","MAGIC","EFFECT","SPELL","ATTACK","BOMB","EXPLOSION","BLAST","FIRE","ICE","THUNDER","STORM","WIND","EARTH","WATER","SHADOW","LIGHT","DARK","HOLY","DEMON","DRAGON","PHOENIX","WOLF","SKILL","POWER","BURST","SLASH","CUT","STAB"}) do
        if string.match(nome, k) then return true end
    end
    return false
end

function ativarNoVFX()
    Connections.VFX = workspace.DescendantAdded:Connect(function(obj)
        if not NightHub.NoVFXAtivo then return end
        pcall(function()
            if isHabilidade(obj.Name) or (obj.Parent and isHabilidade(obj.Parent.Name)) then
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") then obj.Enabled = false
                elseif obj:IsA("Sound") then obj.Volume = 0 end
            end
        end)
    end)
end

function desativarNoVFX()
    if Connections.VFX then Connections.VFX:Disconnect(); Connections.VFX = nil end
end

-- Velocidade
function ativarVelocidadeExtra()
    if Connections.SpeedLoop then Connections.SpeedLoop:Disconnect() end
    Connections.SpeedLoop = RunService.Heartbeat:Connect(function()
        if not NightHub.VelocidadeExtra then return end
        pcall(function()
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("Humanoid") then
                local speed = NightHub.OriginalWalkSpeed * NightHub.SpeedMultiplier
                if speed > 25 then speed = 25 end
                char.Humanoid.WalkSpeed = speed
            end
        end)
    end)
end

function desativarVelocidadeExtra()
    if Connections.SpeedLoop then Connections.SpeedLoop:Disconnect(); Connections.SpeedLoop = nil end
    pcall(function()
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            char.Humanoid.WalkSpeed = NightHub.OriginalWalkSpeed
        end
    end)
end

-- Segurança - Garantir que ao renascer a velocidade volta ao normal se toggle estiver desligado
LocalPlayer.CharacterAdded:Connect(function(char)
