local function IsBindMatch(input, bindName)
    if input.UserInputType == Enum.UserInputType.Keyboard then
        return input.KeyCode.Name == bindName
    elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
        return bindName == "Mouse1"
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
        return bindName == "Mouse2"
    end
    return false
end

Connections.InputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if IsBindMatch(input, Binds.ToggleUI) then
        ScreenGui.Enabled = not ScreenGui.Enabled
        return
    end
    
    if UIHovered and ScreenGui.Enabled then return end
    
    if IsBindMatch(input, Binds.Spammer) then
        NightHub.SpammerAtivo = not NightHub.SpammerAtivo
        UpdateUIToggle("Spammer", NightHub.SpammerAtivo)
        if NightHub.SpammerAtivo then iniciarSpammer() else pararSpammer() end
    elseif IsBindMatch(input, Binds.Farm) then
        NightHub.TweenFarmAtivo = not NightHub.TweenFarmAtivo
        UpdateUIToggle("Farm", NightHub.TweenFarmAtivo)
        if NightHub.TweenFarmAtivo then iniciarFarm() else pararFarm() end
    elseif IsBindMatch(input, Binds.NoVFX) then
        NightHub.NoVFXAtivo = not NightHub.NoVFXAtivo
        UpdateUIToggle("NoVFX", NightHub.NoVFXAtivo)
        if NightHub.NoVFXAtivo then ativarNoVFX() else desativarNoVFX() end
    elseif IsBindMatch(input, Binds.Speed) then
        NightHub.VelocidadeExtra = not NightHub.VelocidadeExtra
        UpdateUIToggle("Speed", NightHub.VelocidadeExtra)
        if NightHub.VelocidadeExtra then ativarVelocidadeExtra() else desativarVelocidadeExtra() end
    end
end)

