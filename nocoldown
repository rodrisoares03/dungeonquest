-- OCULTAR SÓ HABILIDADES (NÃO MEXE NO MAPA)
-- =========================================================================
local function isHabilidade(nome: string)
    nome = string.upper(nome)
    local keywords = {
        "PULSE", "LIGHTNING", "MAGIC", "EFFECT", "SPELL", "ATTACK",
        "BOMB", "EXPLOSION", "BLAST", "FIRE", "ICE", "THUNDER",
        "STORM", "WIND", "EARTH", "WATER", "SHADOW", "LIGHT",
        "DARK", "HOLY", "DEMON", "DRAGON", "PHOENIX", "WOLF",
        "SKILL", "POWER", "BURST", "SLASH", "CUT", "STAB",
        "PIERCE", "CRUSH", "SMASH", "BEAM", "BALL", "WAVE",
        "AURA", "FIELD", "ZONE", "CIRCLE", "RING", "ORB",
        "PROJECTILE", "MISSILE", "LASER", "RAY", "BOLT",
        "SHOCK", "FLAME", "FROST", "SPARK", "GLOW", "RADIANT"
    }
    
    for _, keyword in ipairs(keywords) do
        if string.match(nome, keyword) then
            return true
        end
    end
    return false
end

local function estaEmFerramenta(obj: Instance)
    local current = obj
    while current do
        if current:IsA("Tool") then
            return true
        end
        current = current.Parent
    end
    return false
end

local function ocultarHabilidade(obj: Instance)
    if not getgenv().NoVFXAtivo then return end
    
    pcall(function()
        -- SÓ OCULTA SE FOR HABILIDADE
        local ehHabilidade = isHabilidade(obj.Name)
        if not ehHabilidade and obj.Parent then
            ehHabilidade = isHabilidade(obj.Parent.Name)
        end
        
        -- Verifica se está em uma ferramenta (habilidade)
        local emFerramenta = estaEmFerramenta(obj)
        
        -- SÓ oculta se for habilidade OU estiver em ferramenta
        if not ehHabilidade and not emFerramenta then
            return
        end
        
        -- OCULTA PARTÍCULAS (só de habilidades)
        if obj:IsA("ParticleEmitter") then
            obj.Enabled = false
            obj.Rate = 0
            return
        end
        
        -- OCULTA TRAIL (rastro)
        if obj:IsA("Trail") then
            obj.Enabled = false
            return
        end
        
        -- OCULTA BEAM (feixe)
        if obj:IsA("Beam") then
            obj.Enabled = false
            return
        end
        
        -- OCULTA FOGO
        if obj:IsA("Fire") then
            obj.Enabled = false
            obj.Size = 0
            return
        end
        
        -- OCULTA FUMAÇA
        if obj:IsA("Smoke") then
            obj.Enabled = false
            return
        end
        
        -- OCULTA CHISPAS
        if obj:IsA("Sparkles") then
            obj.Enabled = false
            return
        end
        
        -- OCULTA EXPLOSÕES (destrói)
        if obj:IsA("Explosion") then
            obj:Destroy()
            return
        end
        
        -- OCULTA LUZES (só de habilidades)
        if obj:IsA("PointLight") or obj:IsA("SurfaceLight") or obj:IsA("SpotLight") then
            obj.Enabled = false
            return
        end
        
        -- OCULTA SONS (só de habilidades)
        if obj:IsA("Sound") then
            obj.Volume = 0
            obj:Stop()
            return
        end
        
        -- OCULTA DECALS (só de habilidades)
        if obj:IsA("Decal") or obj:IsA("Texture") then
            if obj.Parent and isHabilidade(obj.Parent.Name) then
                obj.Transparency = 1
            end
            return
        end
        
        -- OCULTA PARTES (só se for claramente habilidade)
        if obj:IsA("BasePart") then
            -- Verifica se é uma parte de habilidade
            local ehParteHabilidade = false
            
            -- Nome é de habilidade
            if isHabilidade(obj.Name) then
                ehParteHabilidade = true
            end
            
            -- Pai é de habilidade
            if obj.Parent and isHabilidade(obj.Parent.Name) then
                ehParteHabilidade = true
            end
            
            -- Verifica características de habilidade
            if obj.Transparency and obj.Transparency < 0.5 and obj.CanCollide == false and obj.Anchored then
                ehParteHabilidade = true
            end
            
            -- Está dentro de uma ferramenta
            if emFerramenta then
                ehParteHabilidade = true
            end
            
            if ehParteHabilidade then
                obj.Transparency = 1
                obj.CanCollide = false
                -- NÃO muda o material para não bugar o mapa
            end
            return
        end
        
        -- OCULTA GUI (só de habilidades)
        if obj:IsA("BillboardGui") or obj:IsA("ScreenGui") or obj:IsA("SurfaceGui") then
            if isHabilidade(obj.Name) or (obj.Parent and isHabilidade(obj.Parent.Name)) then
                obj.Enabled = false
            end
            return
        end
        
        -- OCULTA MESHES (só de habilidades)
        if obj:IsA("SpecialMesh") or obj:IsA("CylinderMesh") or obj:IsA("BlockMesh") then
            if isHabilidade(obj.Name) or (obj.Parent and isHabilidade(obj.Parent.Name)) then
                obj.Visible = false
            end
            return
        end
    end)
end

-- =========================================================================
-- SCANEAR E OCULTAR SÓ HABILIDADES
-- =========================================================================
local function scanearOcultar()
    if not getgenv().NoVFXAtivo then return end
    
    pcall(function()
        -- Só escaneia objetos que podem ser habilidades
        for _, obj in ipairs(workspace:GetDescendants()) do
            -- Pula objetos do mapa (chão, paredes, etc)
            if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") then
                -- Verifica se é parte do mapa ou cenário
                local parentName = string.upper(obj.Parent.Name)
                if string.match(parentName, "MAP") or string.match(parentName, "FLOOR") or 
                   string.match(parentName, "WALL") or string.match(parentName, "GROUND") or
                   string.match(parentName, "TERRAIN") then
                    -- PULA (NÃO OCULTA O MAPA)
                    continue
                end
            end
            
            -- Só oculta se for habilidade
            ocultarHabilidade(obj)
        end
        
        -- NÃO MEXE NO LIGHTING (não oculta efeitos de pós-processamento)
    end)
end

