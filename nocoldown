    sliderKnob.Position = UDim2.new((default - min) / (max - min), -7, 0, -4)
    sliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    sliderKnob.BorderSizePixel = 0
    sliderKnob.Parent = sliderBar
    
    local knobCorner = Instance.new("UICorner")
    knobCorner.CornerRadius = UDim.new(1, 0)
    knobCorner.Parent = sliderKnob
    
    local dragButton = Instance.new("TextButton")
    dragButton.Size = UDim2.new(2, 0, 2, 0)
    dragButton.Position = UDim2.new(-0.5, 0, -0.5, 0)
    dragButton.BackgroundTransparency = 1
    dragButton.Text = ""
    dragButton.Parent = sliderKnob
    
    local dragging = false
    
    dragButton.MouseButton1Down:Connect(function() dragging = true end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mousePos = UserInputService:GetMouseLocation()
            local barPos = sliderBar.AbsolutePosition
            local barSize = sliderBar.AbsoluteSize
            
            local percent = math.clamp((mousePos.X - barPos.X) / barSize.X, 0, 1)
            local value = math.floor(min + (max - min) * percent)
            
            sliderFill.Size = UDim2.new(percent, 0, 1, 0)
            sliderKnob.Position = UDim2.new(percent, -7, 0, -4)
            valueLabel.Text = name .. ": " .. value
            callback(value)
        end
    end)
    
    parent.CanvasSize += UDim2.new(0, 0, 0, 66)
    return sliderBar
end

