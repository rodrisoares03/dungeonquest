    if char:FindFirstChild("Humanoid") then
        -- Guarda o walk speed original do jogo
        NightHub.OriginalWalkSpeed = char.Humanoid.WalkSpeed
        
        task.wait(0.2)
        -- Só aplica velocidade extra se o toggle estiver ativo
        if NightHub.VelocidadeExtra then
            local speed = NightHub.OriginalWalkSpeed * NightHub.SpeedMultiplier
            if speed > 25 then speed = 25 end
            char.Humanoid.WalkSpeed = speed
        else
            -- Garante que volta ao valor padrão do jogo
            char.Humanoid.WalkSpeed = NightHub.OriginalWalkSpeed
        end
    end
end)

