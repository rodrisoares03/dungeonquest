-- Tabela de configs nomeadas em memória: { ["Nome"] = { dados... } }
local SavedConfigs = {}

local function getAllConfigs()
    local ok, exists = pcall(isfile, configsFileName)
    if not ok or not exists then return {} end
    local ok2, content = pcall(readfile, configsFileName)
    if not ok2 or not content then return {} end
    local ok3, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok3 or type(data) ~= "table" then return {} end
    return data
end

local function writeAllConfigs(tbl)
    local ok, str = pcall(function() return HttpService:JSONEncode(tbl) end)
    if ok then pcall(writefile, configsFileName, str) end
end

local function getCurrentSnapshot()
