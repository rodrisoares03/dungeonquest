-- =========================================================================
-- VELOCIDADE EXTRA
-- =========================================================================
function ativarVelocidadeExtra()
    if speedLoop then return end
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        originalWalkSpeed = char.Humanoid.WalkSpeed
    end
    
    speedLoop = RunService.Heartbeat:Connect(function()
        if not getgenv().VelocidadeExtra then
            desativarVelocidadeExtra()
            return
        end
        
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                local targetSpeed = originalWalkSpeed * speedMultiplier
                if targetSpeed > 25 then targetSpeed = 25 end
                if humanoid.WalkSpeed ~= targetSpeed then
                    humanoid.WalkSpeed = targetSpeed
                end
            end
        end)
    end)
end

function desativarVelocidadeExtra()
    if speedLoop then
        speedLoop:Disconnect()
        speedLoop = nil
    end
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        char.Humanoid.WalkSpeed = originalWalkSpeed
    end
end

-- =========================================================================
-- SPAMMER COM SPAM DUPLO (MESMO BOTÃO)
-- =========================================================================
local function spamRemotes(parentFolder)
    if not parentFolder then return end
    
    for _, item in ipairs(parentFolder:GetChildren()) do
        if item:IsA("Tool") then
            -- Pega TODOS os remotes
            local remotes = {}
            for _, obj in ipairs(item:GetDescendants()) do
                if obj:IsA("RemoteEvent") then
                    table.insert(remotes, obj)
                end
            end
            
            -- Spama TODOS os remotes (duplo automático)
            for _, remote in ipairs(remotes) do
                pcall(function()
                    local mousePos = LocalPlayer:GetMouse().Hit.Position
                    remote:FireServer(mousePos)
                    remote:FireServer(item.Name, mousePos)
                    remote:FireServer(mousePos, item.Name)
                end)
            end
        end
    end
end

function iniciarSpammer()
    if spamLoop then return end
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        originalWalkSpeed = char.Humanoid.WalkSpeed
    end
    
    spamLoop = RunService.Stepped:Connect(function()
        if not getgenv().SpammerAtivo then 
            pararSpammer()
            return 
        end
        
        pcall(function()
            local char = LocalPlayer.Character
            if not char then return end
            
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid and getgenv().VelocidadeExtra then
                local targetSpeed = originalWalkSpeed * speedMultiplier
                if targetSpeed > 25 then targetSpeed = 25 end
                if humanoid.WalkSpeed ~= targetSpeed then
                    humanoid.WalkSpeed = targetSpeed
                end
            end
            
            -- Spam em TODOS os remotes (duplo automático)
            spamRemotes(char)
            spamRemotes(LocalPlayer:FindFirstChild("Backpack"))
            
            -- Ativa TODAS as ferramentas (duplo automático)
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    pcall(function()
                        tool:Activate()
                        -- Ativa 2x para garantir (spam duplo no mesmo botão)
                        tool:Activate()
                    end)
                end
            end
            
            preventKick()
        end)
    end)
end

function pararSpammer()
    if spamLoop then
        spamLoop:Disconnect()
        spamLoop = nil
    end
    
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("Humanoid") then
        if getgenv().VelocidadeExtra then
            local targetSpeed = originalWalkSpeed * speedMultiplier
            if targetSpeed > 25 then targetSpeed = 25 end
            char.Humanoid.WalkSpeed = targetSpeed
        else
            char.Humanoid.WalkSpeed = originalWalkSpeed
        end
    end
end

-- =========================================================================
-- TWEEN FARM
-- =========================================================================
local function getClosestEnemy()
    local closest = nil
    local shortestDist = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("Humanoid") and obj.Name ~= LocalPlayer.Name then
            local hum = obj:FindFirstChild("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            
            if hum and hrp and hum.Health > 0 then
                local dist = (hrp.Position - myPos).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closest = obj
                end
            end
        end
    end
    return closest
end

function iniciarFarm()
    if farmLoop then return end
    
    farmLoop = RunService.Stepped:Connect(function()
        if not getgenv().TweenFarmAtivo then 
            pararFarm()
            return 
        end
        
        pcall(function()
            local char = LocalPlayer.Character
            if not char or not char:FindFirstChild("HumanoidRootPart") then return end
            local hrp = char.HumanoidRootPart
            local humanoid = char:FindFirstChild("Humanoid")
            
            if humanoid then
                humanoid.AutoRotate = true
                humanoid.Sit = false
                humanoid.PlatformStand = false
                
                if getgenv().VelocidadeExtra then
                    local targetSpeed = originalWalkSpeed * speedMultiplier
                    if targetSpeed > 25 then targetSpeed = 25 end
                    humanoid.WalkSpeed = targetSpeed
                end
            end
            
            local targetEnemy = getClosestEnemy()
            
            if targetEnemy and targetEnemy:FindFirstChild("HumanoidRootPart") then
                local targetHrp = targetEnemy.HumanoidRootPart
                local targetHum = targetEnemy:FindFirstChild("Humanoid")
                
                if targetHum and targetHum.Health > 0 then
                    local destPosition = Vector3.new(
                        targetHrp.Position.x,
                        targetHrp.Position.y + getgenv().TweenHeight,
                        targetHrp.Position.z
                    )
                    
                    local currentPos = hrp.Position
                    local direction = Vector3.new(
                        destPosition.x - currentPos.x,
                        0,
                        destPosition.z - currentPos.z
                    )
                    
                    local distance = direction.Magnitude
                    
                    if distance > 0.5 then
                        local moveSpeed = getgenv().TweenSpeed * 0.3
                        local moveAmount = math.min(moveSpeed, distance)
                        local newPos = currentPos + direction.Unit * moveAmount
                        newPos = Vector3.new(newPos.x, destPosition.y, newPos.z)
                        hrp.Position = newPos
                    else
                        hrp.Position = destPosition
                    end
                    
                    local lookTarget = Vector3.new(targetHrp.Position.x, hrp.Position.y, targetHrp.Position.z)
                    hrp.CFrame = CFrame.new(hrp.Position, lookTarget)
                    
                    -- Spam duplo durante farm
                    spamRemotes(char)
                    spamRemotes(LocalPlayer:FindFirstChild("Backpack"))
                    
                    for _, tool in ipairs(char:GetChildren()) do
                        if tool:IsA("Tool") then
                            pcall(function()
                                tool:Activate()
                                tool:Activate() -- Duplo
                            end)
                        end
                    end
                    
                    preventKick()
                end
            end
        end)
    end)
end

function pararFarm()
    if farmLoop then
        farmLoop:Disconnect()
        farmLoop = nil
    end
    
    local char = LocalPlayer.Character
    if char then
        local humanoid = char:FindFirstChild("Humanoid")
        if humanoid then
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
            humanoid.Sit = false
            
            if getgenv().VelocidadeExtra then
                local targetSpeed = originalWalkSpeed * speedMultiplier
                if targetSpeed > 25 then targetSpeed = 25 end
                humanoid.WalkSpeed = targetSpeed
            else
                humanoid.WalkSpeed = originalWalkSpeed
            end
        end
    end
end

-- =========================================================================
-- SISTEMA DE SEGURANÇA
-- =========================================================================
local function preventKick()
    pcall(function()
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChild("Humanoid")
            if humanoid then
                if getgenv().VelocidadeExtra then
                    local safeSpeed = originalWalkSpeed * 1.3
                    if safeSpeed > 25 then safeSpeed = 25 end
                    if humanoid.WalkSpeed > safeSpeed then
                        humanoid.WalkSpeed = safeSpeed
                    end
                end
            end
        end
    end)
end

